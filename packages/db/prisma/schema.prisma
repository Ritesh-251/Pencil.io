generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]
  messages      Message[]
  rooms         RoomMember[]
  ownedRooms    Room[] @relation("RoomCreator")
  joinRequests  JoinRequest[]
}

model RefreshToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  userId      String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  lastUsedAt  DateTime?

  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}



model Room {
  id          String   @id @default(uuid())
  name        String?
  createdAt   DateTime @default(now())

  createdBy   String
  creator     User @relation("RoomCreator", fields: [createdBy], references: [id])

  visibility  RoomVisibility @default(PUBLIC)
  memberCount Int @default(1)

  members  RoomMember[]
  messages Message[]

  joinRequests        JoinRequest[]
  canvasObjects       CanvasObject[]
  canvasSnapshots     CanvasSnapshot[]
  canvasActionHistory CanvasActionHistory[]
  transcriptSegments  TranscriptSegment[]
  sessionChunks       SessionChunk[]
  sessionSummary      SessionSummary?

  @@index([createdBy])
}

model RoomMember {
  id     String @id @default(uuid())

  userId String
  roomId String
  role   RoomRole @default(MEMBER)

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
}



model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  userId String
  roomId String

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
}



model CanvasObject {
  id        String   @id
  roomId    String
  userId    String
  type      String
  data      Json // keep (backward compatibility)
  crdt      Json // NEW
  time      BigInt?
  actorId   String?
  version   Int // lastAppliedVersion
  createdAt DateTime
  updatedAt DateTime

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, version])    
  @@index([roomId, time, actorId])
  @@index([roomId, createdAt])
}

model CanvasSnapshot {
  id        String   @id @default(uuid())
  roomId    String
  type      SnapshotType
  baseVersion Int?
  data      Json
  version   Int
  createdAt DateTime

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, version])
  @@index([roomId, type, version])
}



model CanvasActionHistory {
  id        String   @id @default(uuid())

  roomId    String
  userId    String

  actionType CanvasActionType
  objectId   String

  before     Json
  after      Json

  time       BigInt?
  actorId    String?
  version    Int

  
  isUndone          Boolean  @default(false)
  isRedoInvalidated Boolean  @default(false)
  undoneAtVersion   Int?
  referenceActionId String?

 
  eventId String @unique

  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, version])
  @@index([roomId, userId, version])
  @@index([roomId, userId, isUndone])
  @@index([roomId, userId, isUndone, isRedoInvalidated])
  @@index([roomId, userId, undoneAtVersion])
  @@index([objectId, version])
  @@index([objectId, time, actorId])
  @@index([roomId, time, actorId])
  @@index([roomId, createdAt])
}



model ProcessedEvent {
  eventId  String   @id
  createdAt DateTime @default(now())
}

// ─── Stage 7: Transcription ───────────────────────────────────────────────────

model TranscriptSegment {
  id                  String   @id @default(uuid())
  roomId              String
  participantIdentity String   // LiveKit participant identity
  text                String
  startMs             Int      // ms offset from session start
  endMs               Int
  createdAt           DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startMs])
  @@index([roomId, createdAt])
}

// ─── Stage 8: AI RAG ─────────────────────────────────────────────────────────

model SessionChunk {
  id        String   @id @default(uuid())
  roomId    String
  content   String   // text of the timeline window
  embedding Unsupported("vector(1536)")?  // OpenAI ada-002 embedding
  startMs   Int      // start of the time window this chunk covers
  endMs     Int
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([roomId, startMs])
}

model SessionSummary {
  id        String   @id @default(uuid())
  roomId    String   @unique
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model JoinRequest {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CanvasActionType {
  CREATE
  UPDATE
  DELETE
  UNDO
  REDO
}

enum SnapshotType {
  BASE
  DELTA
}



enum RoomRole {
  ADMIN
  MEMBER
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}