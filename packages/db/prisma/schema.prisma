generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]
  messages      Message[]
  rooms         RoomMember[]
  ownedRooms    Room[] @relation("RoomCreator")
}

model RefreshToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  userId      String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  lastUsedAt  DateTime?

  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}



model Room {
  id          String   @id @default(uuid())
  name        String?
  createdAt   DateTime @default(now())

  createdBy   String
  creator     User @relation("RoomCreator", fields: [createdBy], references: [id])

  visibility  RoomVisibility @default(PUBLIC)
  memberCount Int @default(1)

  members  RoomMember[]
  messages Message[]

  @@index([createdBy])
}

model RoomMember {
  id     String @id @default(uuid())

  userId String
  roomId String
  role   RoomRole @default(MEMBER)

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
}



model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  userId String
  roomId String

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
}



model CanvasObject {
  id        String   @id
  roomId    String
  userId    String
  type      String
  data      Json // keep (backward compatibility)
  crdt      Json // NEW
  time      BigInt?
  actorId   String?
  version   Int // lastAppliedVersion
  createdAt DateTime
  updatedAt DateTime

  @@index([roomId, version])    
  @@index([roomId, time, actorId])
  @@index([roomId, createdAt])
}

model CanvasSnapshot {
  id        String   @id @default(uuid())
  roomId    String
  type      SnapshotType
  baseVersion Int?
  data      Json
  version   Int
  createdAt DateTime

  @@index([roomId, version])
  @@index([roomId, type, version])
}



model CanvasActionHistory {
  id        String   @id @default(uuid())

  roomId    String
  userId    String

  actionType CanvasActionType
  objectId   String

  before     Json
  after      Json

  time       BigInt?
  actorId    String?
  version    Int

  
  isUndone          Boolean  @default(false)
  isRedoInvalidated Boolean  @default(false)
  undoneAtVersion   Int?
  referenceActionId String?

 
  eventId String @unique

  createdAt DateTime @default(now())


  @@index([roomId, version])
  @@index([roomId, userId, version])
  @@index([roomId, userId, isUndone])
  @@index([roomId, userId, isUndone, isRedoInvalidated])
  @@index([roomId, userId, undoneAtVersion])
  @@index([objectId, version])
  @@index([objectId, time, actorId])
  @@index([roomId, time, actorId])
  @@index([roomId, createdAt])
}



model ProcessedEvent {
  eventId  String   @id
  createdAt DateTime @default(now())
}

enum CanvasActionType {
  CREATE
  UPDATE
  DELETE
  UNDO
  REDO
}

enum SnapshotType {
  BASE
  DELTA
}



enum RoomRole {
  ADMIN
  MEMBER
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}