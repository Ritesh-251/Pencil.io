# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/pencil
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672

# Auth Configuration
ACCESS_TOKEN_SECRET=replace-with-secure-secret
REFRESH_TOKEN_SECRET=replace-with-refresh-secret
INTERNAL_SECRET=replace-with-shared-internal-secret

# Mailing Configuration (Google SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
FRONTEND_URL=http://localhost:3000

# Media & Transcription
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL=2h
DEEPGRAM_API_KEY=replace-with-deepgram-key

# Microservices
AI_SERVICE_URL=http://localhost:3004
